# =============================================================================
# horizon_mod_builder .gitignore
# =============================================================================

# --- Built / generated output (never commit) ---
*.hnmod
*.hnmod.build
build/
out/
dist/
target/
*.class

# --- Cargo / Rust (user's local cache — NOT your account) ---
/cargo/
/.target/
Cargo.lock
*.rs.bak

# --- Minecraft / launcher secrets & user data (NEVER commit) ---
.minecraft/launcher_msa_credentials.bin
.minecraft/launcher_accounts.json
.minecraft/launcher_entitlements.json
.minecraft/launcher_profiles.json
.minecraft/usercache.json
**/usercache.json
.minecraft/saves/
.minecraft/resourcepacks/
.minecraft/assets/
.minecraft/objects/
.minecraft/logs/
.minecraft/downloads/
.minecraft/webcache2/
.minecraft/staging/
.minecraft/update_files/
.minecraft/runtime/
.minecraft/bin/
.minecraft/launcher/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Temporary / local ---
__pycache__/
.work/
*.tmp
*.bak
*.log

# --- Agent work: keep tests/tools/outputs and small verification logs ---
.agent-work/tmp/*
!.agent-work/tmp/.gitkeep
.agent-work/logs/*
!.agent-work/logs/tests.log
!.agent-work/logs/import-test-final.log
!.agent-work/logs/import-test-script.log
!.agent-work/logs/upload-dry-run.log
!.agent-work/logs/build-test-final.log
!.agent-work/logs/build-test-remote-default-combine.log
